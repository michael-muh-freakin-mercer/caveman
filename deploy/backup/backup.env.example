# Settings for deploy/backup/backup.sh and restore-drill.sh. Copy to
# deploy/backup/backup.env on the server (git-ignored), chmod 600.
# Values are plain KEY=value with no spaces; this file is sourced.

# DigitalOcean Spaces bucket (Spaces Object Storage, private) and an access key
# scoped to that bucket (Read/Write/Delete).
SPACES_BUCKET=cavman-backups
SPACES_ENDPOINT=nyc3.digitaloceanspaces.com
SPACES_KEY=
SPACES_SECRET=

# Public half of an age key pair (age-keygen). Keep the private half in your
# password manager, never on the server: the server writes backups it cannot read.
BACKUP_AGE_RECIPIENT=age1...

# Days to keep each nightly set (1-30; the privacy policy promises at most 30).
BACKUP_RETENTION_DAYS=14

# Optional: a URL to GET after each successful backup (Sentry cron monitor,
# Healthchecks.io, ...), so a missed night alerts someone.
# BACKUP_PING_URL=
