# Caveman API and worker configuration. Copy to `.env` (gitignored) and fill in.
# Never commit real secrets. The web app has its own file: web/.env.example.

# --- Service boundary (required) --------------------------------------------
# Shared secret the web server presents on every API call. Browsers never see it.
# Generate with: openssl rand -hex 32   (minimum 32 characters)
CAVEMAN_API_TOKEN=

# Where Caveman keeps platform state, the operational database, project
# repositories and delivery archives. Use a persistent volume in production.
CAVEMAN_DATA_DIR=.local/caveman

# development | production. Production refuses the scripted test executor and
# hides the interactive API docs.
CAVEMAN_ENV=development

# provider (real models, needs OPENROUTER_API_KEY) | scripted (credit-free test
# executor: scripted models, real kernel and sandbox; refused in production).
CAVEMAN_EXECUTOR=provider

# workflow (default): plain code drives plan -> delegate -> validate -> review ->
# accept -> recover; models only plan, do the work and review. manager: the
# Manager model drives every step through tool calls (the original mode; more
# model calls, and it accepts follow-up instructions on continue).
CAVEMAN_ORCHESTRATION=workflow

# --- Model provider (worker only) --------------------------------------------
# Required for CAVEMAN_EXECUTOR=provider. The placeholder value is rejected.
OPENROUTER_API_KEY=your_openrouter_key_here
WALTER_MODEL_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Manager and specialist models. Any tool-calling model on OpenRouter works,
# e.g. moonshotai/kimi-k3, deepseek/..., qwen/...
WALTER_MODEL=moonshotai/kimi-k3
WALTER_WORKER_MODEL=moonshotai/kimi-k3
# WALTER_WORKER_MAX_TURNS=24

# --- Spending protection -----------------------------------------------------
# Every run gets a USD ceiling (enforced on provider-reported cost) and a
# model-call ceiling (which also bounds calls whose cost was not reported).
CAVEMAN_DEFAULT_BUDGET_USD=5
CAVEMAN_MAX_BUDGET_USD=100
CAVEMAN_DEFAULT_MAX_MODEL_CALLS=300
# Per-account monthly ceilings across all runs (new work is refused once reached).
CAVEMAN_ACCOUNT_MONTHLY_BUDGET_USD=25
CAVEMAN_ACCOUNT_MONTHLY_MAX_CALLS=3000
# Optional global caps applied on top of per-run budgets (stricter wins):
# WALTER_MAX_COST_USD=20
# WALTER_MAX_MODEL_CALLS=500
# WALTER_MAX_INPUT_TOKENS=5000000
# WALTER_MAX_OUTPUT_TOKENS=1000000
# WALTER_MAX_TOTAL_TOKENS=6000000

# --- Worker tuning (optional) ------------------------------------------------
# CAVEMAN_MANAGER_MAX_TURNS=60     # Manager turns per execution session
# CAVEMAN_LEASE_SECONDS=90         # a silent worker's job is recovered after this
# CAVEMAN_HEARTBEAT_SECONDS=5
# CAVEMAN_MAX_RECOVERIES=3         # automatic recoveries per run after worker loss
# CAVEMAN_SCRIPTED_STEP_DELAY=0.25 # scripted executor only
# CAVEMAN_LOG_LEVEL=INFO
# CAVEMAN_LOG_FORMAT=json           # one JSON object per log line
# CAVEMAN_METRICS_TOKEN=            # enables GET /api/metrics (Prometheus) with this bearer token
