# Caveman web app configuration. Copy to `web/.env.local` (gitignored).

# Private Caveman API (never exposed to browsers) and the shared service token.
CAVEMAN_API_URL=http://127.0.0.1:8000
CAVEMAN_API_TOKEN=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this web app (used for OAuth callbacks and redirects).
BETTER_AUTH_URL=http://localhost:3000

# Auth storage: a postgres:// URL for managed Postgres, or a SQLite file path.
AUTH_DATABASE_URL=.local/caveman-auth.db
# Auth tables are created automatically on first use; set to 0 to manage
# migrations yourself (npx auth migrate).
# CAVEMAN_AUTH_AUTO_MIGRATE=1

# Optional GitHub sign-in (identity scopes only: read:user, user:email).
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Test suite only: CAVEMAN_E2E=1 disables auth rate limiting. Never set it in production.
